// Order Operations - Prisma schema
// Shopify is the source of truth for order data: the app reads orders live
// through the Admin GraphQL API and never keeps a local order cache.
// This database stores sessions plus the small amount of app-internal
// operational data that does not exist in Shopify: notes, COD status,
// staff assignment, saved views, and settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum CodStatus {
  NOT_COD
  PENDING
  VERIFIED
  FAILED
  CANCELLED
}

model Shop {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  scope       String?
  installedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  staff        Staff[]
  opsMeta      OrderOpsMeta[]
  notes        OrderNote[]
  assignments  OrderAssignment[]
  savedViews   SavedView[]
  settings     ShopSettings?
}

model User {
  id            String   @id @default(cuid())
  shopId        String
  shopifyUserId BigInt?
  name          String
  email         String?
  createdAt     DateTime @default(now())

  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  notes OrderNote[]

  @@index([shopId])
}

model Staff {
  id            String   @id @default(cuid())
  shopId        String
  name          String
  email         String?
  shopifyUserId BigInt?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignments OrderAssignment[]
  opsMeta     OrderOpsMeta[]

  @@index([shopId])
}

// App-internal overlay for one Shopify order. Created lazily the first time
// someone adds a note, sets a COD status, or assigns the order - order data
// itself always comes live from Shopify, never from this table.
model OrderOpsMeta {
  id              String    @id @default(cuid())
  shopId          String
  shopifyOrderId  String
  codStatus       CodStatus @default(NOT_COD)
  assignedStaffId String?
  notesCount      Int       @default(0)
  latestNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  shop          Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  assignedStaff Staff? @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@unique([shopId, shopifyOrderId])
  @@index([shopId])
}

model OrderNote {
  id             String   @id @default(cuid())
  shopId         String
  shopifyOrderId String
  authorId       String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop   Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([shopId, shopifyOrderId, createdAt])
}

model OrderAssignment {
  id             String   @id @default(cuid())
  shopId         String
  shopifyOrderId String
  staffId        String
  assignedAt     DateTime @default(now())

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([shopId, shopifyOrderId])
  @@index([shopId, staffId])
}

model SavedView {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  filters   Json // serialized OrderFilters
  sort      Json? // { column, direction }
  columns   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model ShopSettings {
  shopId              String   @id
  highValueThreshold  Decimal  @default(5000) @db.Decimal(12, 2)
  defaultViewId       String?
  defaultSort         String? // e.g. "orderedAt:desc"
  defaultColumns      String[] @default([])
  rowsPerPage         Int      @default(50)
  codEnabled          Boolean  @default(true)
  defaultCodStatus    CodStatus @default(PENDING)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
