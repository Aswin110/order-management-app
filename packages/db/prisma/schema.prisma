// Order Operations - Prisma schema
// This app is an order viewer: Shopify is the source of truth for every
// order, read live through the Admin GraphQL API. There is no local order
// cache and no app-internal order state. The database holds only the
// Shopify OAuth session plus each shop's preferences - which columns to
// show, how to sort, any saved filter sets, and the workflow stage and
// staff names. Workflow state itself is stored as Shopify order tags.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  scope       String?
  installedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedViews SavedView[]
  settings   ShopSettings?
}

// A named filter/sort/column combination, e.g. "Today's unfulfilled".
// Purely a way to re-open a Shopify query; it stores no order data.
model SavedView {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  filters   Json // serialized OrderFilters
  sort      Json? // { column, direction }
  columns   String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model ShopSettings {
  shopId         String   @id
  defaultViewId  String?
  defaultSort    String? // e.g. "orderedAt:desc"
  defaultColumns String[] @default([])
  rowsPerPage    Int      @default(50)
  // Workflow stage labels, in order. Empty means the built-in defaults.
  workflowStages String[] @default([])
  // People orders can be assigned to.
  staffNames     String[] @default([])
  // Show line item properties whose key starts with "_".
  showInternalProperties Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
