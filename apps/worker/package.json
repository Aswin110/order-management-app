{
  "name": "@order-operations/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"worker: lint via root eslint\" && exit 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@order-operations/db": "workspace:*",
    "@order-operations/shared": "workspace:*",
    "@shopify/shopify-api": "^11.9.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}