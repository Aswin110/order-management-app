# Shopify app credentials (from the Dev Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel-or-host.example.com
SCOPES=read_orders,write_orders

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_operations

# Redis (for BullMQ background jobs: order sync, CSV exports, bulk actions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App
NODE_ENV=development
SESSION_SECRET=change-me
EXPORT_DIR=./exports
