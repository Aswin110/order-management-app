# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT: only DATABASE_URL is required.
# `shopify app dev` injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/order_operations

# ---------------------------------------------------------------------------
# PRODUCTION: set these on the host. They are NOT needed for `pnpm dev`.
# ---------------------------------------------------------------------------
# Shopify app credentials (from the Dev Dashboard)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPIFY_APP_URL=https://your-host.example.com

# Access scopes live in shopify.app.toml under [access_scopes].
# Only set SCOPES here if you deliberately need to override that file.
# SCOPES=read_orders,write_orders

# Billing (Shopify App Pricing). The plan and price are set in the Partner
# Dashboard; these let the app check a shop's subscription through the Partner
# API. Billing is enforced only when all three are set.
# SHOPIFY_PARTNER_ORG_ID=            # the number in your Partner Dashboard URL
# SHOPIFY_PARTNER_API_ACCESS_TOKEN=  # Partner API client with "Manage apps"
# SHOPIFY_APP_GID=gid://shopify/App/<app id from the Partner Dashboard URL>
# Only if the app handle is not "order-operations":
# SHOPIFY_APP_HANDLE=

# NODE_ENV is set by vite in dev; set it to "production" on your host.
# NODE_ENV=production
